---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base title={`${site.name} — portfolio`}>
  <header>
    <h1>{site.name}</h1>
    <p class="bio">
      based in <span class="accent">{site.city}</span>. {site.blurb}
    </p>
    <nav class="socials">
      {site.socials.map((s) =>
        s.copy
          ? <button type="button" class="copy-btn" data-copy={s.copy} aria-label={`copy ${s.copy} to clipboard`}>{s.label}</button>
          : s.href
            ? <a href={s.href}>{s.label}</a>
            : <span>{s.label}</span>
      )}
    </nav>
  </header>

  {site.work.length > 0 && (
    <section>
      <h2>experience</h2>
      <ul class="projects">
        {site.work.map((w) => (
          <li>
            {w.href
              ? <a href={w.href}><span class="name">{w.org}</span></a>
              : <span class="name">{w.org}</span>}
            <span class="badge">{w.period}</span>
            <p>{w.role}{w.blurb ? ` · ${w.blurb}` : ""}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <h2>projects</h2>
    <ul class="projects">
      {site.projects.map((p) => (
        <li>
          <a href={p.href}><span class="name">{p.name}</span></a>
          <span class="badge">{p.updated}</span>
          <p>{p.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  {site.writing.length > 0 && (
    <section>
      <h2>writing</h2>
      <ul class="links">
        {site.writing.map((w) => (
          <li><a href={w.href}>{w.title}</a> <time>{w.date}</time></li>
        ))}
      </ul>
    </section>
  )}

  <section>
    <h2>other</h2>
    <ul class="links">
      {site.other.map((e) => (
        <li><a href={e.href}>{e.label}</a></li>
      ))}
    </ul>
  </section>

  <footer>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>

  <script is:inline>
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy;
        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "copied!";
        } catch {
          btn.textContent = "copy failed";
        }
        setTimeout(() => { btn.textContent = original; }, 1500);
      });
    });
  </script>
</Base>
